# Internal / not for publication: kdb table schemas and reference data
no_git/

# q artefacts
*.log
*.qdb

# python artefacts, from running the scripts' --self-test
__pycache__/

# report output written by the scripts
scripts/*/out/

# local, untracked settings: servers, recipients - see scripts/lib/README.md
scripts/*/local_settings.py

# launcher output: the run logs, and this machine's python/log settings
launchers/logs/
launchers/local_settings.cmd
